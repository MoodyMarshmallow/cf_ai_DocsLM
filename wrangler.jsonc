{
	"name": "docs-lm",
	"main": "workers/api/src/index.ts",
	"compatibility_date": "2026-02-01",
	"vars": {
		"ENVIRONMENT": "dev",
		"EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
		"CHAT_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_SESSIONS",
				"class_name": "ChatSessionDO"
			}
		]
	},
	"workflows": [
		{
			"name": "IndexProjectWorkflow",
			"class_name": "IndexProjectWorkflow",
			"binding": "WORKFLOWS"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ChatSessionDO"
			]
		}
	],
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "docs_lm",
			"database_id": "611444fb-f23d-44cb-af6b-7d3b8b247d63",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "docs-lm",
			"binding": "DOCS_BUCKET",
			"remote": true
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE_INDEX",
			"index_name": "docs_chunks",
			"remote": true
		}
	]
}